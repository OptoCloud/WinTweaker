{
  "Retweak": {
    "EventSourceName": "Retweak",
    "EventLogName": "Application",
    "LogDirectory": "%ProgramData%\\Retweak\\logs",
    "LogFileMaxBytes": 4194304,
    "LogFileRetainCount": 5,

    "DebounceMilliseconds": 250,
    "AuditIntervalMinutes": 60,
    "HiveReconcileSeconds": 60,
    "LogonHiveWaitSeconds": 60,

    "CaseInsensitiveStringCompare": true,
    "AllowExpandStringEquivalence": true,
    "EnableOfflineProfiles": false,

    "Entries": [
      {
        "Scope": "Machine",
        "Path": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "Name": "DisableConsumerFeatures",
        "Kind": "DWord",
        "Value": "1",
        "Watch": true
      },
      {
        "Scope": "PerUser",
        "Path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "Name": "HideFileExt",
        "Kind": "DWord",
        "Value": "0",
        "Watch": true
      }
    ]
  },

  "ServiceControl": {
    "RefuseStop": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Retweak.Service.Infra.RegistryWatcher": "Information"
    }
  }
}
